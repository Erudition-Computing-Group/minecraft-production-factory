{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Concept & Spec",
  "type": "object",
  "required": ["theme", "edition", "particle_types", "colors", "animation_style", "budget", "compliance"],
  "properties": {
    "theme": { "type": "string" },
    "edition": { "enum": ["java", "bedrock"] },
    "particle_types": { "type": "array", "items": { "type": "string" } },
    "colors": {
      "type": "object",
      "properties": {
        "primary": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 }, "minItems": 3, "maxItems": 3 },
        "secondary": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 }, "minItems": 3, "maxItems": 3 }
      },
      "required": ["primary"]
    },
    "animation_style": { "enum": ["flapping", "rotating", "trailing", "bursting", "ambient"] },
    "budget": {
      "type": "object",
      "properties": {
        "max_particles_per_tick": { "type": "integer", "minimum": 1 },
        "culling_radius_blocks": { "type": "integer", "minimum": 1 }
      },
      "required": ["max_particles_per_tick", "culling_radius_blocks"]
    },
    "compliance": { "type": "string" }
  }
}
